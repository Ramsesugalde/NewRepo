# Copy these variable NAMES into Netlify's own environment variable settings
# (Site configuration -> Environment variables) — do not commit real values
# here or anywhere in this repo. This file is a template only.

# Bearer token from your Kindroid account/API settings.
KINDROID_API_KEY=

# The Kindroid inference endpoint URL (from Kindroid's API docs/dashboard).
KINDROID_INFER_URL=

# The "share code" identifying which of your Kindroid personas to talk to.
KINDROID_SHARE_CODE=
